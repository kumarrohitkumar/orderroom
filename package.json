{
  "name": "orderroom",
  "version": "0.1.0",
  "description": "An FMCG distributor's order desk: salesmen on Telegram, office on Mattermost, one AI agent placed by Switch, rules enforced in code.",
  "license": "MIT",
  "author": "Rohit Kumar",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "setup": "npm run build && tsx scripts/setup.ts",
    "seed": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "bind": "tsx scripts/bind.ts",
    "bind-room": "tsx scripts/bind-room.ts",
    "mcp": "node dist/mcp/server.js",
    "template": "tsx scripts/build-template.ts",
    "clean-room": "bash scripts/clean-room.sh",
    "simulate": "npm run build && tsx scripts/simulate.ts",
    "add-user": "tsx scripts/add-user.ts",
    "mm-say": "tsx scripts/mm-say.ts",
    "mm-read": "tsx scripts/mm-read.ts",
    "mm-demo": "tsx scripts/mm-demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "fsevents": false
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  }
}
